NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact public deployment origin; required before production.
APP_ORIGIN=http://127.0.0.1:3000
# Server-only; never use NEXT_PUBLIC_ for API secrets.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_BUILD=
OPENAI_MODEL_GROWTH=
# Optional product analytics. Events require consent and a signed-in user.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
# Stripe sandbox only. See docs/BILLING.md before enabling.
STRIPE_BILLING_ENABLED=false
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUILD=
STRIPE_PRICE_GROWTH=
SUPABASE_SERVICE_ROLE_KEY=
